{"subassunto": "A085-01",
 "estilos": [
  {"codigo": "A085-01-E1", "nome": "Localiza informação explícita no texto", "descricao": "Pede o que o texto diz, afirma, indica ou destaca (\"de acordo com o texto\", \"segundo\", \"é correto afirmar\", dados de infográfico); a resposta é paráfrase de algo dito, sem dedução nem foco em um recurso específico."},
  {"codigo": "A085-01-E2", "nome": "Interpreta efeito de recurso, palavra ou trecho", "descricao": "Foca um elemento pontual (palavra, título, verso, trecho, citação, figura, estratégia de construção) e pede seu sentido/efeito, ou pede qual trecho/verso expressa certa ideia."},
  {"codigo": "A085-01-E3", "nome": "Infere informação implícita", "descricao": "Pede conclusão, sugestão ou pressuposto não dito (\"infere-se\", \"conclui-se\", \"sugere\", \"depreende-se\", \"revela\", caracterização de personagem/sensação); exige deduzir além do que está escrito."},
  {"codigo": "A085-01-E4", "nome": "Identifica a crítica ou o humor do texto", "descricao": "Pede o alvo da crítica, a ironia, o que gera humor ou a mensagem de charge, tirinha, cartum ou grafite; usar quando o comando menciona crítica, ironia ou humor, ou pede a mensagem de texto de humor."},
  {"codigo": "A085-01-E5", "nome": "Reconhece a finalidade do texto", "descricao": "Pede o objetivo, propósito ou função do texto como um todo (reportagem, campanha, anúncio, tirinha, foto); não usar para objetivo de algo descrito no texto (isso é E1)."},
  {"codigo": "A085-01-E6", "nome": "Relaciona dois ou mais textos", "descricao": "Pede convergência, contraste, complementação ou relação entre textos distintos (Texto I e Texto II, poema e canção etc.)."},
  {"codigo": "A085-01-E7", "nome": "Identifica o ponto de vista do autor", "descricao": "Pede o posicionamento, a tese, a opinião ou a visão (positiva/negativa) que o autor, narrador ou texto defende sobre o tema, não um dado factual."},
  {"codigo": "A085-01-E8", "nome": "Identifica o tema ou a ideia central", "descricao": "Pede o assunto, tema, foco ou ideia principal do texto (\"o texto trata de\", \"aborda\", \"reflete sobre\", \"tema\", \"chama a atenção para\")."}
 ],
