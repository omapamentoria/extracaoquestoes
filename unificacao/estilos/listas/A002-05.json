{"subassunto": "A002-05",
 "estilos": [
  {"codigo": "A002-05-E1", "nome": "Calcula o montante ou os juros", "descricao": "Dados capital, taxa e prazo (simples ou compostos, inclusive multa/mora ou taxas variáveis), pede o montante, os juros, o aumento percentual ou o lucro/saldo resultante; o passo decisivo é capitalizar."},
  {"codigo": "A002-05-E2", "nome": "Calcula o capital ou valor presente", "descricao": "Dado o montante ou os juros, pede o capital inicial, o valor à vista, o valor original ou quanto aplicar/aportar; o passo decisivo é descapitalizar (dividir pelo fator). Pagamento único; várias parcelas vão em E6."},
  {"codigo": "A002-05-E3", "nome": "Calcula o tempo da aplicação", "descricao": "Pede o prazo (meses/anos/parcela) para atingir um montante, dobrar/triplicar ou obter desconto; em compostos exige logaritmo."},
  {"codigo": "A002-05-E4", "nome": "Monta a expressão do montante", "descricao": "Alternativas são fórmulas/expressões algébricas (M = C(1+i)^t, C + Cit, razões entre montantes); o aluno escolhe o modelo correto, sem calcular valor numérico."},
  {"codigo": "A002-05-E5", "nome": "Compara aplicações ou formas de pagamento", "descricao": "Pede qual opção (banco, plano, regime, provedor, forma de pagamento) é mais vantajosa ou a diferença entre elas; o passo decisivo é comparar resultados de duas ou mais alternativas."},
  {"codigo": "A002-05-E6", "nome": "Calcula parcelas de um financiamento", "descricao": "Dívida paga em duas ou mais parcelas ou com saldo devedor: pede o valor da parcela, o valor à vista equivalente às parcelas, o total pago ou a quitação antecipada."},
  {"codigo": "A002-05-E7", "nome": "Calcula a taxa de juros", "descricao": "Pede a taxa (ou percentual de juros embutido numa compra a prazo), incluindo conversão para taxa equivalente de outro período."},
  {"codigo": "A002-05-E9", "nome": "Outros", "descricao": "Leitura qualitativa de gráfico de dívida, juros real frente à inflação e retorno de investimento sem juros."}
 ],
