{"subassunto": "A030-04",
 "estilos": [
  {"codigo": "A030-04-E1", "nome": "Calcula massa ou mols pela proporção da reação", "descricao": "Relação direta reagente-produto (massa, mol ou cadeia de reações) a 100%, sem pureza/rendimento, gás, solução ou limitante decisivos."},
  {"codigo": "A030-04-E2", "nome": "Aplica rendimento, pureza ou teor", "descricao": "O passo decisivo é um percentual: rendimento, pureza, teor em mistura/minério, fração que reage ou excesso percentual; inclui calcular a pureza/teor a partir de massas."},
  {"codigo": "A030-04-E3", "nome": "Relaciona quantidade com volume de gás", "descricao": "Usa volume molar (CNTP/CATP) ou PV=nRT para converter entre mol/massa e volume ou pressão de gás envolvido na reação."},
  {"codigo": "A030-04-E4", "nome": "Usa concentração de solução ou titulação", "descricao": "Parte de ou chega a concentração (mol/L, g/L, mg/L, pH) e volume de solução; inclui neutralização e titulação, mesmo quando pede a pureza."},
  {"codigo": "A030-04-E5", "nome": "Identifica reagente limitante ou em excesso", "descricao": "São dadas quantidades de dois ou mais reagentes e é preciso descobrir qual limita a reação ou quanto sobra."},
  {"codigo": "A030-04-E6", "nome": "Calcula mols, átomos ou composição sem reação", "descricao": "Não há equação química: converte massa em mol/átomos, calcula composição percentual, hidratação ou fórmula molecular."},
  {"codigo": "A030-04-E7", "nome": "Analisa coeficientes e proporções da equação", "descricao": "Pede balancear ou interpretar coeficientes (razão em mol, conservação de massa, afirmações sobre a equação), sem cálculo a partir de dado numérico externo."},
  {"codigo": "A030-04-E9", "nome": "Outros", "descricao": "Equivalência energética, questões interdisciplinares de múltiplas afirmações, razão de densidades ou texto ilegível."}
 ],
